{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Py调试当前",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        {
            "name": "CLIP_BASE_VID_CNN",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/train_vid.py", // 关键修改点1
            "args": [
                "--config_file",
                "configs/person/cnn_base_vid.yml"
            ],
            "env": {
                "CUDA_VISIBLE_DEVICES": "0"
            },
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}" // 关键修改点2
        },
        {
